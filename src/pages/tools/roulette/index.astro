---
import ToolLayout from "../../../layouts/ToolLayout.astro";

const counts = [6, 8, 10, 12];
---
<ToolLayout title="ルーレット" description="配信で使える番号付きルーレット。円盤が回って、上の針の位置で止まります。">
  <main class="stage">
    <p class="stage-kicker">Roulette</p>
    <h1 class="stage-title">ルーレット</h1>
    <div class="die-faces" role="group" aria-label="番号の数">
      {counts.map((count) => (
        <button type="button" data-count={count} aria-pressed={count === 10 ? "true" : "false"}>{count}</button>
      ))}
    </div>
    <div class="roulette">
      <div class="roulette-pointer" aria-hidden="true"></div>
      <div class="roulette-disc" id="rotor"></div>
    </div>
    <p class="die-value" id="result" aria-live="polite">–</p>
    <button type="button" class="stage-btn" id="spin">回す</button>
    <p class="stage-links">
      <a class="stage-back" href="/tools/dice/">サイコロ</a>
      <a class="stage-back" href="/plans/">企画一覧へ戻る</a>
    </p>
  </main>
  <script>
    import { createRoulette } from "../../../scripts/roulette-wheel.js";

    const rotor = document.getElementById("rotor");
    const result = document.getElementById("result");
    const spinButton = document.getElementById("spin");
    const countButtons = [...document.querySelectorAll("[data-count]")];
    const roulette = createRoulette(rotor);
    let count = 10;

    function numbers(total) {
      return Array.from({ length: total }, (_, index) => String(index + 1));
    }

    function setCount(next) {
      if (!roulette.setItems(numbers(next))) return;
      count = next;
      countButtons.forEach((button) => {
        button.setAttribute("aria-pressed", Number(button.dataset.count) === next ? "true" : "false");
      });
      result.textContent = "–";
      result.classList.remove("is-set");
      spinButton.textContent = "回す";
    }

    async function spin() {
      if (roulette.isSpinning()) return;
      spinButton.disabled = true;
      spinButton.textContent = "回転中…";
      result.classList.remove("is-set");
      result.textContent = "";
      const index = await roulette.spin();
      result.textContent = String(index + 1);
      result.classList.add("is-set");
      spinButton.disabled = false;
      spinButton.textContent = "もう一度";
    }

    setCount(count);
    countButtons.forEach((button) => {
      button.addEventListener("click", () => setCount(Number(button.dataset.count)));
    });
    spinButton.addEventListener("click", spin);
    window.addEventListener("keydown", (event) => {
      if (event.code !== "Space" || event.repeat) return;
      if (event.target instanceof HTMLButtonElement && event.target.dataset.count) return;
      event.preventDefault();
      spin();
    });
  </script>
</ToolLayout>
