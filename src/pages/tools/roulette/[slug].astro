---
import ToolLayout from "../../../layouts/ToolLayout.astro";
import { PLANS } from "../../../data/plans.js";

export function getStaticPaths() {
  return PLANS.filter((plan) => plan.roulette?.length).map((plan) => ({
    params: { slug: plan.slug },
    props: { plan },
  }));
}

const { plan } = Astro.props;
---
<ToolLayout title={`${plan.title} ルーレット`} description={`${plan.title}の追加罰ゲームルーレット`}>
  <main class="stage">
    <p class="stage-kicker">Penalty roulette</p>
    <h1 class="stage-title">{plan.title}</h1>
    <div class="roulette">
      <div class="roulette-pointer" aria-hidden="true"></div>
      <div class="roulette-disc" id="rotor"></div>
    </div>
    <p class="stage-result" id="result" aria-live="polite">まだ回していません</p>
    <button type="button" class="stage-btn" id="spin">回す</button>
    <ol class="roulette-legend">
      {plan.roulette.map((item, index) => (
        <li><span>{index + 1}</span>{item}</li>
      ))}
    </ol>
    <a class="stage-back" href={`/plans/${plan.slug}/`}>企画の内容に戻る</a>
  </main>
  <script id="roulette-items" type="application/json" set:html={JSON.stringify(plan.roulette)} />
  <script>
    import { createRoulette } from "../../../scripts/roulette-wheel.js";

    const items = JSON.parse(document.getElementById("roulette-items").textContent);
    const rotor = document.getElementById("rotor");
    const result = document.getElementById("result");
    const spinButton = document.getElementById("spin");
    const roulette = createRoulette(rotor);
    roulette.setItems(items);

    async function spin() {
      if (roulette.isSpinning()) return;
      spinButton.disabled = true;
      spinButton.textContent = "回転中…";
      result.classList.remove("is-set");
      result.textContent = "";
      const index = await roulette.spin();
      result.textContent = `${index + 1} ${items[index]}`;
      result.classList.add("is-set");
      spinButton.disabled = false;
      spinButton.textContent = "もう一度";
    }

    spinButton.addEventListener("click", spin);
    window.addEventListener("keydown", (event) => {
      if (event.code !== "Space" || event.repeat) return;
      event.preventDefault();
      spin();
    });
  </script>
</ToolLayout>
