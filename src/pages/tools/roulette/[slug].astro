---
import ToolLayout from "../../../layouts/ToolLayout.astro";
import { PLANS } from "../../../data/plans.js";

export function getStaticPaths() {
  return PLANS.filter((plan) => plan.roulette?.length).map((plan) => ({
    params: { slug: plan.slug },
    props: { plan },
  }));
}

const { plan } = Astro.props;
---
<ToolLayout title={`${plan.title} ルーレット`} description={`${plan.title}の追加罰ゲームルーレット。項目数とタグは設定ボタンから変えられます。`}>
  <main class="stage" data-storage-key={`hina-chi:roulette:${plan.slug}`} data-idle-text="まだ回していません">
    <p class="stage-kicker">Penalty roulette</p>
    <h1 class="stage-title">{plan.title}</h1>
    <div class="roulette">
      <div class="roulette-pointer" aria-hidden="true"></div>
      <div class="roulette-disc" id="rotor"></div>
    </div>
    <p class="roulette-outcome" id="result" aria-live="polite">まだ回していません</p>
    <div class="stage-actions">
      <button type="button" class="stage-btn" id="spin">回す</button>
      <button type="button" class="stage-btn stage-btn-ghost" id="settings-toggle" aria-expanded="false" aria-controls="roulette-settings">設定</button>
    </div>
    <div id="roulette-settings" class="roulette-settings" hidden>
      <div class="roulette-count">
        <span id="count-label">項目数</span>
        <button type="button" id="count-dec" aria-label="項目を減らす">−</button>
        <input id="roulette-count" type="number" min="2" max="30" inputmode="numeric" aria-labelledby="count-label" />
        <button type="button" id="count-inc" aria-label="項目を増やす">＋</button>
      </div>
      <ol id="roulette-tag-list" class="roulette-tag-list"></ol>
      <div class="roulette-settings-actions">
        <button type="button" class="stage-btn" id="roulette-apply">反映する</button>
        <button type="button" class="stage-btn stage-btn-ghost" id="roulette-reset">最初の内容に戻す</button>
      </div>
    </div>
    <ol class="roulette-legend" id="legend" hidden></ol>
    <a class="stage-back" href={`/plans/${plan.slug}/`}>企画の内容に戻る</a>
  </main>
  <script id="roulette-items" type="application/json" set:html={JSON.stringify(plan.roulette)} />
  <script>
    import { mountRoulettePage } from "../../../scripts/roulette-page.js";

    const root = document.querySelector("[data-storage-key]");
    const defaults = JSON.parse(document.getElementById("roulette-items").textContent);
    mountRoulettePage({
      defaults,
      storageKey: root.dataset.storageKey,
      idleText: root.dataset.idleText,
    });
  </script>
</ToolLayout>
